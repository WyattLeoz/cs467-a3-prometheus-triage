[
  {"project": "postgres_exporter", "where": "https://github.com/prometheus-community/postgres_exporter", "patterns": ["postgres_exporter", "postgres exporter"]},
  {"project": "blackbox_exporter", "where": "https://github.com/prometheus/blackbox_exporter", "patterns": ["blackbox[ _]exporter", "blackbox setup", "probe_success"]},
  {"project": "node_exporter", "where": "https://github.com/prometheus/node_exporter", "patterns": ["node[ _]exporter"]},
  {"project": "windows_exporter", "where": "https://github.com/prometheus-community/windows_exporter", "patterns": ["windows[ _]exporter"]},
  {"project": "snmp_exporter", "where": "https://github.com/prometheus/snmp_exporter", "patterns": ["snmp[ _]exporter"]},
  {"project": "mysqld_exporter", "where": "https://github.com/prometheus/mysqld_exporter", "patterns": ["mysqld[ _]exporter"]},
  {"project": "pushgateway", "where": "https://github.com/prometheus/pushgateway", "patterns": ["pushgateway"]},
  {"project": "alertmanager", "where": "https://github.com/prometheus/alertmanager", "patterns": ["\\balertmanager\\b.{0,40}\\b(silence|inhibit|route|receiver|amtool)"]},
  {"project": "kube-prometheus-stack Helm chart", "where": "https://github.com/prometheus-community/helm-charts", "patterns": ["kube-prometheus-stack", "helm chart", "helm install", "community chart"]},
  {"project": "prometheus-operator", "where": "https://github.com/prometheus-operator/prometheus-operator", "patterns": ["prometheus-operator", "prometheus operator", "servicemonitor", "podmonitor", "prometheus cr\\b"]},
  {"project": "Grafana", "where": "https://community.grafana.com/", "patterns": ["grafana"]},
  {"project": "Thanos / Mimir / Cortex", "where": "the respective project's issue tracker", "patterns": ["\\bthanos\\b", "\\bmimir\\b", "\\bcortex\\b"]},
  {"project": "client libraries", "where": "https://github.com/prometheus (client_golang, client_java, client_python, ...)", "patterns": ["client_golang", "client_java", "client_python", "client[_ ]library"]},
  {"project": "vendor-managed Prometheus", "where": "the vendor's support channel", "patterns": ["azure monitor", "managed prometheus", "amazon managed service for prometheus", "\\bamp\\b workspace", "google managed prometheus", "prom-remotewrite"]},
  {"project": "OpenTelemetry Collector", "where": "https://github.com/open-telemetry/opentelemetry-collector-contrib", "patterns": ["otel(?:-| )collector", "opentelemetry collector", "otlphttp exporter"]}
]
